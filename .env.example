# Configuration template; keep real credentials in an ignored .env.

# Documentation placeholders only. No provider has been selected.
# Keep working credentials in an ignored local .env file.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
SECRET_KEY=
# LOCAL DEVELOPMENT ONLY: uncomment in your ignored .env for loopback HTTP.
# DESKGUIDE_LOCAL_HTTP=1

# HTTPS deployments require SECRET_KEY and leave local HTTP disabled.
# Behind a trusted proxy only: set each header's actual trusted proxy count.
# Keep the application reachable only through those proxies; direct mode trusts none.
# DESKGUIDE_PROXY_X_FOR=1
# DESKGUIDE_PROXY_X_PROTO=1
