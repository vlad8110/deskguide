        <mxCell id="app-provider" edge="1" parent="1" source="deploy-app" style="endArrow=classic;html=1;rounded=0;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=6;startArrow=classic;fontSize=13;" target="deploy-ai" value="M4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="app-customer" edge="1" parent="1" source="deploy-app" style="endArrow=classic;html=1;rounded=0;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=6;startArrow=classic;fontSize=13;" target="deploy-customer-db" value="M7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="app-state" edge="1" parent="1" source="deploy-app" style="endArrow=classic;html=1;rounded=0;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=6;startArrow=classic;fontSize=13;" target="deploy-postgres" value="M9 | Shared durable state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deploy-shared-controls" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#000000;strokeColor=#333333;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;Shared identity / submission controls (proposed)&lt;/b&gt;&lt;br&gt;Sessions: 30-min idle / 8-h maximum.&lt;br&gt;Role changes revoke existing sessions.&lt;br&gt;Unused IDs: 30-min fixed expiry; max 3 per customer across operations.&lt;br&gt;Fourth registration: 429; never evict.&lt;br&gt;Uncertain save: retain original ID." vertex="1">
          <mxGeometry height="190" width="340" x="30" y="125" as="geometry" />
        </mxCell>
        <mxCell id="deploy-timing" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#000000;strokeColor=#333333;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;Admission / deadlines (proposed)&lt;/b&gt;&lt;br&gt;Aggregate AI limit across replicas; no waiting queue.&lt;br&gt;20-s overall / provider at most 12 s / 1-s fallback reserve.&lt;br&gt;Known failure: immediate fallback.&lt;br&gt;No automatic generation retry.&lt;br&gt;Support admission is separately bounded." vertex="1">
          <mxGeometry height="190" width="340" x="810" y="125" as="geometry" />
        </mxCell>
        <mxCell id="deploy-breaker-policy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#000000;strokeColor=#333333;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;Breaker coordination (proposed)&lt;/b&gt;&lt;br&gt;Prototype: 3 consecutive qualifying failures / 60 s.&lt;br&gt;Production candidate: ≥50% qualifying failures over rolling 10 s; minimum 20 completed calls.&lt;br&gt;30-s cooldown / one global recovery trial / 20-s lease.&lt;br&gt;Scope: provider + model + credential; respect quota resets.&lt;br&gt;No database lock during the provider call." vertex="1">
          <mxGeometry height="145" width="550" x="30" y="900" as="geometry" />
        </mxCell>
        <mxCell id="deploy-retention-policy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fontColor=#000000;strokeColor=#333333;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;Retention / recovery (proposed)&lt;/b&gt;&lt;br&gt;Inquiry metadata + feedback: 30 days; diagnostics: 7 days.&lt;br&gt;Support / receipts / minimal audit: open + 30 days resolved.&lt;br&gt;Release summaries: active / rollback version + 30 days retired.&lt;br&gt;Block at expiry; daily live purge within 24 h; backups: 7 days.&lt;br&gt;Reapply expiry / deletions before restored data is available." vertex="1">
          <mxGeometry height="145" width="550" x="600" y="900" as="geometry" />
        </mxCell>
